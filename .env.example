# ==================================================================
# CONFIGURACIÓN DEL SERVIDOR · COLÁGENO VITAL
# Copia este archivo como .env (copy .env.example .env) y completa
# tus credenciales reales. Nunca subas el archivo .env al repositorio.
# ==================================================================

# Puerto HTTP del servidor
PORT=3000

# URL pública del servidor (usada para webhooks y el widget embebible).
# En desarrollo local puede quedar http://localhost:3000.
# En producción debe usar HTTPS (Meta y Telegram lo exigen).
PUBLIC_BASE_URL=http://localhost:3000

# ==================================================================
# SEGURIDAD DEL PANEL (/admin)
# ==================================================================
# Contraseña inicial del panel de administración (cámbiala en Ajustes > Seguridad)
ADMIN_PASSWORD=admin123

# Secreto HMAC para firmar la sesión. Si se deja vacío se genera uno
# automáticamente y se guarda en data/.secret
SESSION_SECRET=

# ==================================================================
# INTEGRACIÓN CON GOOGLE GEMINI AI (RECOMENDADO)
# ==================================================================
# Proveedor de IA por defecto (gemini | openai | anthropic | compatible | demo)
AI_PROVIDER=gemini

# Clave de API de Google Gemini.
# Consíguela en Google AI Studio: https://aistudio.google.com/app/apikey
# Si se deja vacía y no hay clave en el panel, el chatbot responde en modo demo
# seguro utilizando la base de conocimiento local.
GEMINI_API_KEY=

# Modelo de Google Gemini para el chatbot (puedes cambiarlo sin modificar código)
# Opciones recomendadas: gemini-3.6-flash | gemini-3.8-flash | gemini-3.5-flash-lite | gemini-3.1-pro-preview
# gemini-3.8-flash puede saturarse y agotar el tiempo de espera; el chat cambia
# automaticamente al modelo de respaldo si eso ocurre.
GEMINI_MODEL=gemini-3.6-flash

# Modelo de embeddings de Gemini (cuando se selecciona Gemini para búsqueda vectorial)
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Parámetros opcionales de generación y red para Gemini
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_TOKENS=900
GEMINI_TIMEOUT_MS=25000
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ==================================================================
# OTROS PROVEEDORES DE IA (OPCIONALES)
# ==================================================================
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ==================================================================
# OPCIONES DE ALMACENAMIENTO Y LÍMITES
# ==================================================================
# Carpeta de datos persistentes (base de conocimiento, conversaciones, leads)
# DATA_DIR=./data

# Límite de peticiones al chat público por dirección IP (por minuto)
PUBLIC_RATE_LIMIT=20
